		workflow
		{
		form
		{
			Decrease_available_copies as "Decrease available copies"
			{
				type =  form
				form = Book
				record event = on add

				field rules
				{
				}

			}
			Membership_types as "Membership types"
			{
				type =  form
				form = Member_Info
				record event = on add

				on user input of Membership_Type
				{
					actions 
					{
						custom deluge script
						(
											if(input.Membership_Type == "Basic")
										{
											input.Max_Books_Allowed = 2;
										}
										else if(input.Membership_Type == "Premium")
										{
											input.Max_Books_Allowed = 5;
										}
										else if(input.Membership_Type == "Elite")
										{
											input.Max_Books_Allowed = 10;
										}
						)
					}
				}

			}
			Publication_After_1990 as "Publication After 1990"
			{
				type =  form
				form = Book
				record event = on add

				on user input of Publication_Year
				{
					actions 
					{
						custom deluge script
						(
											// Get the current year dynamically
										currentYear = zoho.currentdate.getYear();
										publication_year = input.Publication_Year;
										// Validate the publication year
										if(publication_year < 1990 || publication_year > currentYear)
										{
											// Display an error message and stop submission
											info "The publication year must be after 1990.";
											alert publication_year;
											info "Please Enter the year after 1990";
											delete from Book[Publication_Year < 1990];
											reload;
										}
						)
					}
				}

			}
			Return_Date_is_greater_th as "Return Date is greater than the Issue Date"
			{
				type =  form
				form = Book_Transaction
				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validate that Return Date is greater than Issue Date
										if(input.Return_date <= input.Issue_date)
										{
											alert "Return Date must be greater than Issue Date. Please correct the dates.";
											cancel submit;
										}
						)
					}
				}

			}
			Increase_available_copies as "Increase available copies"
			{
				type =  form
				form = Book_Transaction
				record event = on add

				on success
				{
					actions  (Status == "Returned")
					{
						custom deluge script
						(
											// Fetch the selected book record
										selectedBook = Book[ID == input.Book];
										// Update the Available Copies field
										selectedBook.Available_Copies=selectedBook.Available_Copies + 1;
						)
					}
				}

			}
			Decrease_available_copies2 as "Decrease available copies"
			{
				type =  form
				form = Book_Transaction
				record event = on add

				on success
				{
					actions  (Status == "Issued")
					{
						custom deluge script
						(
											// Fetch the selected book record
										selectedBook = Book[ID == input.Book];
										// Check if Available Copies is greater than 0
										if(selectedBook.Available_Copies > 0)
										{
											// Update the Available Copies field
											selectedBook.Available_Copies=selectedBook.Available_Copies - 1;
											// Inform that the operation was successful
											info "Available Copies updated successfully.";
										}
										else
										{
											// Prevent the submission by setting the transaction status to "Unavailable"
											input.Status = "Unavailable";
											info "No available copies left for this book.";
										}
						)
					}
				}

			}
			Overdue_2perday as "Overdue $2perday"
			{
				type =  form
				form = Book_Transaction
				record event = on add

				on success
				{
					actions  (Status == "Overdue")
					{
						custom deluge script
						(
											// Fetch the current date and calculate the overdue period
										todayDate = zoho.currentdate;
										returnDate = input.Return_date;
										// Calculate the overdue days (only if Return Date is past the Issue Date)
										if(todayDate > returnDate)
										{
											overdueDays = todayDate.toDate() - returnDate.toDate();
											// Difference in days
											fineAmount = overdueDays * 2;
											// $2 per day
											// Update the Fine Amount in the transaction
											input.Fine_Amount = fineAmount;
										}
										else
										{
											// If the book is not overdue, set Fine Amount to 0
											input.Fine_Amount = 0;
										}
						)
					}
				}

			}
			Overdue_email as "Overdue email"
			{
				type =  form
				form = Book_Transaction
				record event = on add

				on success
				{
					actions  (Status == "Overdue")
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "zoho.loginuserid"
							subject : "Your status is 'Overdue'"
							message : "<div>${zoho.loginuserid}${zoho.loginuserid}${zoho.adminuserid}${Fine_Amount}${Return_date}${zoho.loginuserid} has added a record in form Book Transaction. Please return the Book.<br></div>"
						)
					}
					actions  (Status == "Overdue")
					{
						custom deluge script
						(
											// Fetch the Member and Book details
										memberEmail = input.Member.Email;
										// Member email field
										bookTitle = input.Book.Title;
										// Book title
										fineAmount = input.Fine_Amount;
										// Fine amount calculated previously
										// Email Content
										subject = "Overdue Book Notification - " + bookTitle;
										message = "Dear " + input.Member.Name + ",\n\n" + "We would like to inform you that the following book is overdue:\n\n" + "Book: " + bookTitle + "\n" + "Fine Amount: $" + fineAmount + "\n\n" + "Please return the book at the earliest to avoid further charges.\n\n" + "Thank you for your cooperation.\n\n" + "Best regards,\n" + "Library Team";
										// Send the email
										sendmail
										[
											from :zoho.adminuserid
											to :zoho.loginuserid
											subject :"Your status is overdue."
											message :"<div>Please return your book, your status is 'OVERDUE',&nbsp;<br></div><div>fine amount for you is $2 per day</div>"
										]
						)
					}
				}

			}
			Member_s_information_is_s as "Member's information is submitted successfully."
			{
				type =  form
				form = Member_Info
				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch Member's Email
										memberEmail = input.Email;
										// The email field of the member
										// Prepare the email subject and message
										subject = "Welcome to the Library, " + input.Name;
										message = "Dear " + input.Name + ",\n\n" + "Thank you for becoming a member of our library. We're excited to have you join our community!\n\n" + "Here are the details of your membership:\n" + "Name: " + input.Name + "\n" + "Membership Type: " + input.Membership_Type + "\n" + "Membership Start Date: " + input.Membership_Start_Date.toString("yyyy-MM-dd") + "\n\n" + "Feel free to explore our collection and borrow books as per your membership type.\n\n" + "Best regards,\n" + "The Library Team";
										// Send the email
										sendmail
										[
											from :zoho.adminuserid
											to :input.Email
											subject :"Successfully Account created!"
											message :"Welcome to Library System Management!.<br><div>Your account has been created!.</div>"
										]
						)
					}
				}

			}
