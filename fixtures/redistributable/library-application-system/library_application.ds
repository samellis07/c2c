	section Section_2
	{
		displayname= "Books"
		icon = "education-books-46"
		form Book
		{
			success message = "Book Added Successfully"
			field alignment = left
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Book_ID
			(
    			type = autonumber
				displayname = "Book ID"
				start index = 512360
	 			row = 1
	 			column = 1   
				width = medium
			)
			Title
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Author
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Genre
			(
				type = picklist
				values = {"Sci-Fi","Biography","Non-Fiction","Fiction"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Publication_Year
			(
				type = number
				displayname = "Publication Year"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			Available_Copies
			(
				type = number
				displayname = "Available Copies"
				maxchar = 13
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			unique Isbn_Number
			(
    			type = text
				displayname = "Isbn Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Rating
			(
				type = number
				displayname = "Rating (1-5)"
				maxchar = 1
				initial value = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Mark_as_Featured
			(
				type = checkboxes	
				displayname = " Mark as Featured"
				initial value = {"No"}
				values = {"Yes","No"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		list Book_Report
		{
			displayName = "All Books"
			show all rows from Book    
			(
