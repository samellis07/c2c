			}
		}






		functions
		{
			Overdue_Books_Report as "Overdue Books Report"
			{
				type =  functions
				form = Book_Transaction
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						if(input.Status == "Overdue")
										{
											// Fetch necessary details
											memberName = input.Member;
											bookTitle = input.Book;
											returnDate = input.Return_date;
											fineAmount = input.Fine_Amount;
											// Add these details to the Overdue Report view
										}
					)
					}
				}
			}
			Overdue_Books_Report1 as "Overdue Books Report"
			{
				type =  functions
				form = Book_Transaction
				execution type = for each record	
				on start
				{
				}
			}
			Group_By_Member_ as "Group By Member."
			{
				type =  functions
				form = Book_Transaction
				execution type = for each record	
				on start
				{
				}
			}
			Mark_as_Featured as "Mark as Featured"
			{
				type =  functions
				form = Book
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						input.Mark_as_Featured = !input.Mark_as_Featured;
										// Toggle the featured status
										if(input.Mark_as_Featured == "Yes")
										{
											info "The book is now marked as Featured.";
										}
										else
										{
											info "The book is no longer marked as Featured.";
										}
					)
					}
				}
			}
			Mark_as_Lost as "Mark as Lost"
			{
				type =  functions
				form = Book_Transaction
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						// Fetch the selected book's record
										bookRecord = Book[ID == input.ID];
										// Check if the record exists
										if(bookRecord != null)
										{
											// Set the Available Copies to 0
											bookRecord.Available_Copies=0;
											// Add a note to the transaction to log the action
											Notes = "Book marked as Lost on " + zoho.currentdate.toString("dd-MMM-yyyy");
											// Notify the user
											info "The book has been marked as lost, and the transaction has been updated.";
										}
										else
										{
											// Notify the user if no book record is found
											info "The book record could not be found. Please check the Book ID.";
										}
					)
					}
				}
			}
			Publication_year_1990 as "Publication year 1990"
			{
				type =  functions
				form = Book
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						// Get the current year dynamically
										currentYear = zoho.currentdate.getYear();
										publication_year = input.Publication_Year;
										// Validate the publication year
										if(publication_year < 1991 || publication_year > currentYear)
										{
											// Display an error message and stop submission
											info "The publication year must be after 1990.";
											reload;
										}
					)
					}
				}
			}
			Overdue_Books as "Overdue Books"
			{
				type =  functions
				form = Book_Transaction
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						// Get the date when the book was issued and the date it was returned
										issue_date = input.Issue_date;
										// Calculate the overdue days
										overdue_days = if(input.Return_date > issue_date,input.Return_date - issue_date,0);
										// Calculate the fine (2 dollars per day overdue)
										fine_amount = overdue_days * 2;
										// Update the Fine Amount field
										input.Fine_Amount = fine_amount;
					)
					}
				}
			}
		}
	}
