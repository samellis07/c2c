application "Precheck_Formula"
{
	forms
	{
		form Item
		{
			Ext
			(
				type = integration
				displayname = "External"
			)
			Total
			(
				type = formula
				displayname = "Total"
				value = input.Ext
			)
		}
	}
	reports
	{
		list All_Items
		{
			displayName = "All Items"
			show all rows from Item
			(
				Ext as "External"
				Total as "Total"
			)
		}
	}
}
