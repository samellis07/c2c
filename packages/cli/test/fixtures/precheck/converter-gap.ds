application "Precheck_Gap"
{
	forms
	{
		form Item
		{
			Pin
			(
				type = geolocation
				displayname = "Pin"
			)
		}
	}
	reports
	{
		list All_Items
		{
			displayName = "All Items"
			show all rows from Item
			(
				Pin as "Pin"
			)
		}
	}
}
