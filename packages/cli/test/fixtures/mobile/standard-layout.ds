application "Standard Mobile"
{
	forms
	{
		form Item
		{
			Name ( type = text )
		}
	}
	phone
	{
		customize
		{
			layout = twocolumn
			font = "default"
			style = "3"
			color options
			{
				color = chryslerpurple
			}
			logo
			{
				preference = "none"
			}
		}
	}
	tablet
	{
		customize
		{
			layout = slidingpane
			font = "default"
			style = "3"
			color options
			{
				color = chryslerpurple
			}
			logo
			{
				preference = "none"
			}
		}
	}
}
