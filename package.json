{
  "name": "creator-to-catalyst",
  "version": "0.2.0",
  "private": true,
  "description": "Convert Zoho Creator apps (.ds exports) to Zoho Catalyst projects",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.20 <23"
  },
  "bin": {
    "c2c": "dist/cli/src/c2c.js"
  },
  "exports": {
    ".": "./dist/core/src/index.js",
    "./deluge": "./dist/deluge/src/index.js",
    "./shims": "./dist/shims/src/index.js",
    "./ui": "./dist/ui/src/index.js",
    "./auth": "./dist/auth/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/ensure-ui-react-template.mjs && node scripts/run-tests.mjs --list scripts/test-files.txt && npm run check:hygiene",
    "check": "npm test && bash tools/determinism-gate.sh",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "tokens:css": "npm run build && node scripts/write-tokens-css.mjs",
    "matrix:check": "node tools/matrix-check.mjs",
    "synthetic:report": "npm run build && node tools/synthetic-report.mjs",
    "matrix:fetch-help": "node tools/fetch-help-sitemap.mjs",
    "determinism:gallery": "npm run build && node dist/determinism/src/gallery.js",
    "determinism:status": "npm run build && node dist/determinism/src/status.js",
    "migration-reports:update": "npm run build && node packages/cli/scripts/update-fixture-migration-reports.mjs",
    "determinism:update": "npm run build && node dist/determinism/src/manifests.js --update",
    "determinism:check": "npm run build && node dist/determinism/src/manifests.js --check",
    "merge-driver:install": "bash tools/install-merge-driver.sh",
    "tables:budget": "npm run build && node dist/determinism/src/table-budget.js",
    "smoke:gallery": "npm run build && node dist/quality/src/gallery.js",
    "score-ui:gallery": "npm run build && node dist/ui-score/src/gallery.js",
    "ui-react:check": "npm run build && node tools/ui-react-check.mjs",
    "golden:baseline": "npm run build && node tests/golden/baseline.mjs",
    "golden:offline-plan:update": "npm run build && node tests/golden/update-offline-plan.mjs",
    "c2c": "node dist/cli/src/c2c.js",
    "ratchet:update": "npm run build && node scripts/update-todo-kinds-ratchet.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "fast-check": "4.10.2",
    "jsdom": "^24.1.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "lossless-json": "4.3.1"
  }
}
