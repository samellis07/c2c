app: call-logs
route: #/form/Log_Call
state: form
viewport: phone 390
---
div class="c2c-app"
  header class="c2c-topbar"
    span
      "Call Logs"
  nav aria-label="Main menu"
    div class="c2c-nav-section"
      h2 class="c2c-nav-heading"
        "App"
      ul
        li
          a aria-current="page" href="#/form/Log_Call"
            svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
              path
              path
              path
              path
              path
            span
              "Log a Call"
        li
          a href="#/report/Recent_Calls"
            svg aria-hidden="true" class="lucide lucide-table c2c-icon"
              path
              rect
              path
              path
            span
              "Recent Calls"
  main tabindex="-1"
    section class="c2c-card" data-form-card=""
      h1
        "Log a Call"
      form data-form="Log_Call" data-layout="one" data-mode="add"
        div class="form-grid"
          div class="c2c-field" data-field="Subject" data-required="true" data-widget="text"
            div class="field"
              label class="label" for="#ref"
                "Subject"
              input class="input" name="Subject" type="text"
          div class="c2c-field" data-field="Direction" data-widget="select"
            div class="field"
              label class="label c2c-label" for="#ref"
                "Direction"
              select class="input" name="Direction"
                option value=""
                option value="Inbound"
                  "Inbound"
                option value="Outbound"
                  "Outbound"
          div class="c2c-field" data-field="Caller" data-widget="phone"
            div class="field"
              label class="label" for="#ref"
                "Caller"
              div class="control"
                div class="anchor"
                  span aria-hidden="true" class="trigger measure"
                    span aria-hidden="true" class="flag"
                      "🇺🇸"
                    span class="dial"
                      "+"
                      "1"
                  div class="shape"
                    div class="lid"
                      button aria-controls="#ref" aria-expanded="false" aria-haspopup="listbox" aria-label="Country, United States +1" class="trigger" tabindex="0" type="button"
                        span class="slot"
                          span class="layer"
                            span aria-hidden="true" class="flag"
                              "🇺🇸"
                            span class="dial"
                              "+"
                              "1"
                      div class="searchRow"
                        svg aria-hidden="true" class="lucide lucide-search searchIcon"
                          path
                          circle
                        input aria-controls="#ref" aria-expanded="false" aria-label="Search countries or calling codes" class="search" placeholder="Country or code" role="combobox" type="text" value=""
                        button aria-label="Close country list" class="closeHit" type="button"
                      span aria-hidden="true" class="chevron"
                        svg aria-hidden="true" class="lucide lucide-chevron-down"
                          path
                    div aria-hidden="true" class="listFace"
                      div class="scroll"
                        div aria-label="Countries" class="options" role="listbox"
                          span aria-hidden="true" class="highlight"
                          div aria-labelledby="#ref" class="group" role="group"
                            div class="groupLabel" role="presentation"
                              "Suggested"
                            div aria-selected="true" class="option" role="option"
                              span aria-hidden="true" class="flag"
                                "🇺🇸"
                              span class="name"
                                "United States"
                              span class="meta"
                                "+"
                                "1"
                              span aria-hidden="true" class="check"
                                svg aria-hidden="true" class="lucide lucide-check"
                                  path
                            div aria-selected="false" class="option" role="option"
                              span aria-hidden="true" class="flag"
                                "🇨🇦"
                              span class="name"
                                "Canada"
                              span class="meta"
                                "+"
                                "1"
                              span aria-hidden="true" class="check"
                                svg aria-hidden="true" class="lucide lucide-check"
                                  path
                            div aria-selected="false" class="option" role="option"
                              span aria-hidden="true" class="flag"
                                "🇬🇧"
                              span class="name"
                                "United Kingdom"
                              span class="meta"
                                "+"
                                "44"
                              span aria-hidden="true" class="check"
                                svg aria-hidden="true" class="lucide lucide-check"
                                  path
                          div aria-labelledby="#ref" class="group" role="group"
