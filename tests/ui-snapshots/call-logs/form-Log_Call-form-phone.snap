                div class="numberWrap"
                  span aria-hidden="true" class="guide"
                    span class="guideTyped"
                    "(201) 555-0123"
                  input class="number" type="tel" value=""
              span aria-live="polite" class="srOnly" role="status"
            input name="Caller" type="hidden" value=""
          div class="c2c-field" data-field="Started_At" data-widget="datetime"
            div class="field"
              label class="label" for="#ref"
                "Started At"
              input class="input" name="Started_At" type="datetime-local"
          div class="c2c-field" data-field="Duration_Min" data-widget="number"
            div
              div class="field"
                div class="head"
                  label class="label" for="#ref"
                    "Duration (min)"
                div class="control"
                  button aria-controls="#ref" aria-label="Decrease Duration (min)" class="step" type="button"
                    span class="icon"
                      svg aria-hidden="true" class="lucide lucide-minus"
                        path
                  div class="valueWrap"
                    span class="value"
                      span class="affix"
                      span class="number"
                        span aria-hidden="true" class="display"
                          span class="column"
                            span class="sizer"
                              "0"
                            span class="glyph"
                              "0"
                            span class="glyph"
                              "1"
                            span class="glyph"
                              "2"
                            span class="glyph"
                              "3"
                            span class="glyph"
                              "4"
                            span class="glyph"
                              "5"
                            span class="glyph"
                              "6"
                            span class="glyph"
                              "7"
                            span class="glyph"
                              "8"
                            span class="glyph"
                              "9"
                        input class="input" role="spinbutton" type="text" value=""
                      span class="affix"
