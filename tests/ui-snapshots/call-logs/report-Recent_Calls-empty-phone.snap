app: call-logs
route: #/report/Recent_Calls
state: empty
viewport: phone 390
---
div class="c2c-app"
  header class="c2c-topbar"
    span
      "Call Logs"
  nav aria-label="Main menu"
    div class="c2c-nav-section"
      h2 class="c2c-nav-heading"
        "App"
      ul
        li
          a href="#/form/Log_Call"
            svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
              path
              path
              path
              path
              path
            span
              "Log a Call"
        li
          a aria-current="page" href="#/report/Recent_Calls"
            svg aria-hidden="true" class="lucide lucide-table c2c-icon"
              path
              rect
              path
              path
            span
              "Recent Calls"
  main tabindex="-1"
    section class="c2c-card" data-report="Recent_Calls" data-view="list"
      h1
        "Recent Calls"
      div class="c2c-report-tools"
        form class="c2c-search-form" role="search"
          label class="c2c-search"
            svg aria-hidden="true" class="lucide lucide-search"
              path
              circle
            input aria-label="Search Recent Calls" placeholder="Search" type="search" value=""
          button class="button secondary sm" tabindex="0" type="submit"
            span class="labelSlot"
              span class="labelContent"
                span class="labelPhase"
                  "Search"
      div class="c2c-report-tools"
        label
          "Field to edit"
          select aria-label="Field to edit"
            option value=""
              "Choose a field"
            option value="Subject"
              "Subject"
            option value="Direction"
              "Direction"
            option value="Caller"
              "Caller"
            option value="Started_At"
              "Started At"
            option value="Duration_Min"
              "Duration (min)"
            option value="Notes"
              "Notes"
        label
          "New value"
          input aria-label="New value" disabled type="text" value=""
        button class="button secondary sm" disabled tabindex="0" type="button"
          span class="labelSlot"
            span class="labelContent"
              span class="labelPhase"
                "Edit 0 selected"
        span aria-live="polite"
          "Maximum 25 rows per batch."
      div data-state="empty"
        section class="root"
          div aria-hidden="true" class="icon"
            span class="glyph"
              svg aria-hidden="true" class="lucide lucide-folder"
                path
          div class="frame"
            div class="copy"
              h3
                span class="line"
                  "No records found"
              p
                span class="line"
                  "Records added through the form appear here."
  nav aria-label="Tabs"
    a href="#/form/Log_Call"
      svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
        path
        path
        path
        path
        path
      span
        "Log a Call"
    a aria-current="page" href="#/report/Recent_Calls"
      svg aria-hidden="true" class="lucide lucide-table c2c-icon"
        path
        rect
        path
        path
      span
        "Recent Calls"
