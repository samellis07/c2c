app: call-logs
route: #/report/Recent_Calls
state: denied
viewport: phone 390
---
div class="c2c-app"
  header class="c2c-topbar"
    span
      "Call Logs"
  nav aria-label="Main menu"
    div class="c2c-nav-section"
      h2 class="c2c-nav-heading"
        "App"
      ul
        li
          a href="#/form/Log_Call"
            svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
              path
              path
              path
              path
              path
            span
              "Log a Call"
        li
          a aria-current="page" href="#/report/Recent_Calls"
            svg aria-hidden="true" class="lucide lucide-table c2c-icon"
              path
              rect
              path
              path
            span
              "Recent Calls"
  main tabindex="-1"
    section class="c2c-card c2c-denied" role="alert"
      h1
        "You don't have access to"
        "Recent Calls"
      p
        "Ask the app administrator for access."
      p
        a class="c2c-link" href="#/"
          "Go to home"
  nav aria-label="Tabs"
    a href="#/form/Log_Call"
      svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
        path
        path
        path
        path
        path
      span
        "Log a Call"
    a aria-current="page" href="#/report/Recent_Calls"
      svg aria-hidden="true" class="lucide lucide-table c2c-icon"
        path
        rect
        path
        path
      span
        "Recent Calls"
