app: contacts
route: #/form/New_Contact
state: form
viewport: phone 390
---
div class="c2c-app"
  header class="c2c-topbar"
    span
      "Contacts"
  nav aria-label="Main menu"
    div class="c2c-nav-section"
      h2 class="c2c-nav-heading"
        "App"
      ul
        li
          a aria-current="page" href="#/form/New_Contact"
            svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
              path
              path
              path
              path
              path
            span
              "New Contact"
        li
          a href="#/form/Person"
            svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
              path
              path
              path
              path
              path
            span
              "Person"
        li
          a href="#/report/All_Contacts"
            svg aria-hidden="true" class="lucide lucide-table c2c-icon"
              path
              rect
              path
              path
            span
              "All Contacts"
  main tabindex="-1"
    section class="c2c-card" data-form-card=""
      h1
        "New Contact"
      form data-form="New_Contact" data-layout="one" data-mode="add"
        div class="form-grid"
          div class="c2c-field" data-field="Full_Name" data-required="true" data-widget="text"
            div class="field"
              label class="label" for="#ref"
                "Full Name"
              input class="input" name="Full_Name" type="text"
          div class="c2c-field" data-field="Email" data-widget="email"
            div class="field"
              label class="label" for="#ref"
                "Email"
              input class="input" name="Email" type="email"
          div class="c2c-field" data-field="Kind" data-widget="select"
            div class="field"
              label class="label c2c-label" for="#ref"
                "Kind"
              select class="input" name="Kind"
                option value=""
                option value="Friend"
                  "Friend"
                option value="Work"
                  "Work"
          div class="c2c-field" data-field="Birthday" data-widget="date"
            div class="field"
              label class="label" for="#ref"
                "Birthday"
              div class="anchor"
                button aria-expanded="false" aria-haspopup="dialog" class="trigger" type="button"
                  svg aria-hidden="true" class="lucide lucide-calendar-days"
                    path
                    path
                    rect
                    path
                    path
                    path
                    path
                    path
                    path
                    path
                  span class="srOnly"
                    "Select a date"
                  span aria-hidden="true" class="valueText"
                    span class="placeholder"
                      "Select a date"
                  svg aria-hidden="true" class="lucide lucide-chevron-down chevron"
                    path
            input aria-label="Birthday value" class="input" name="Birthday" value=""
          div class="c2c-field c2c-lookup" data-field="Owner_Ref" data-widget="lookup-multi"
            div class="field"
              span class="label field-title"
                "Owner_Ref"
              div class="control"
                button aria-controls="#ref" aria-expanded="false" aria-haspopup="listbox" aria-labelledby="#ref #ref" class="trigger " type="button"
                  span class="srOnly"
                    "Select records"
                  span aria-hidden="true" class="value"
                    span class="placeholder"
                      "Select records"
                  svg aria-hidden="true" class="lucide lucide-chevron-down chevron"
                    path
            select aria-label="Owner_Ref selected" class="c2c-lookup-chosen" name="Owner_Ref"
        div class="c2c-form-actions"
          button class="button primary md" tabindex="0" type="submit"
            span class="labelSlot"
              span class="labelContent"
                span class="labelPhase"
                  "Save"
  nav aria-label="Tabs"
    a aria-current="page" href="#/form/New_Contact"
      svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
        path
        path
        path
        path
        path
      span
        "New Contact"
    a href="#/form/Person"
      svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
        path
        path
        path
        path
        path
      span
        "Person"
    a href="#/report/All_Contacts"
      svg aria-hidden="true" class="lucide lucide-table c2c-icon"
        path
        rect
        path
        path
      span
        "All Contacts"
