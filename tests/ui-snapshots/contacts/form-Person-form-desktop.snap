app: contacts
route: #/form/Person
state: form
viewport: desktop 1280
---
div class="c2c-app"
  header class="c2c-topbar"
    span
      "Contacts"
  nav aria-label="Main menu"
    div class="c2c-nav-section"
      h2 class="c2c-nav-heading"
        "App"
      ul
        li
          a href="#/form/New_Contact"
            svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
              path
              path
              path
              path
              path
            span
              "New Contact"
        li
          a aria-current="page" href="#/form/Person"
            svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
              path
              path
              path
              path
              path
            span
              "Person"
        li
          a href="#/report/All_Contacts"
            svg aria-hidden="true" class="lucide lucide-table c2c-icon"
              path
              rect
              path
              path
            span
              "All Contacts"
  main tabindex="-1"
    section class="c2c-card" data-form-card=""
      h1
        "Person"
      form data-form="Person" data-layout="one" data-mode="add"
        div class="form-grid"
          div class="c2c-field" data-field="Name" data-widget="text"
            div class="field"
              label class="label" for="#ref"
                "Name"
              input class="input" name="Name" type="text"
        div class="c2c-form-actions"
          button class="button primary md" tabindex="0" type="submit"
            span class="labelSlot"
              span class="labelContent"
                span class="labelPhase"
                  "Submit"
  nav aria-label="Tabs"
    a href="#/form/New_Contact"
      svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
        path
        path
        path
        path
        path
      span
        "New Contact"
    a aria-current="page" href="#/form/Person"
      svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
        path
        path
        path
        path
        path
      span
        "Person"
    a href="#/report/All_Contacts"
      svg aria-hidden="true" class="lucide lucide-table c2c-icon"
        path
        rect
        path
        path
      span
        "All Contacts"
