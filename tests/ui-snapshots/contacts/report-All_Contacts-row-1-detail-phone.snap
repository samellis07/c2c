app: contacts
route: #/report/All_Contacts/row/1
state: detail
viewport: phone 390
---
div class="c2c-app"
  header class="c2c-topbar"
    span
      "Contacts"
  nav aria-label="Main menu"
    div class="c2c-nav-section"
      h2 class="c2c-nav-heading"
        "App"
      ul
        li
          a href="#/form/New_Contact"
            svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
              path
              path
              path
              path
              path
            span
              "New Contact"
        li
          a href="#/form/Person"
            svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
              path
              path
              path
              path
              path
            span
              "Person"
        li
          a aria-current="page" href="#/report/All_Contacts"
            svg aria-hidden="true" class="lucide lucide-table c2c-icon"
              path
              rect
              path
              path
            span
              "All Contacts"
  main tabindex="-1"
    section class="c2c-card" data-report="All_Contacts" data-row="1" data-view="list"
      h1
        "All Contacts"
      p class="c2c-back"
        a href="#/report/All_Contacts"
          "Back to"
          "All Contacts"
      article aria-label="Ada Lovelace" class="c2c-record"
        h2
          "Ada Lovelace"
        dl
          div
            dt
              "Full Name"
            dd
              "Ada Lovelace"
          div
            dt
              "Email"
            dd
              "ada@example.com"
          div
            dt
              "Kind"
            dd
              "Work"
          div
            dt
              "Birthday"
            dd
              "1815-12-10"
          div
            dt
              "Owner_Ref"
            dd
              "–"
        p
          a aria-label="Edit record 1" class="c2c-row-open" href="#/form/New_Contact/edit/1"
            "Edit"
  nav aria-label="Tabs"
    a href="#/form/New_Contact"
      svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
        path
        path
        path
        path
        path
      span
        "New Contact"
    a href="#/form/Person"
      svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
        path
        path
        path
        path
        path
      span
        "Person"
    a aria-current="page" href="#/report/All_Contacts"
      svg aria-hidden="true" class="lucide lucide-table c2c-icon"
        path
        rect
        path
        path
      span
        "All Contacts"
