app: contacts
route: #/report/All_Contacts
state: list
viewport: desktop 1280
---
div class="c2c-app"
  header class="c2c-topbar"
    span
      "Contacts"
  nav aria-label="Main menu"
    div class="c2c-nav-section"
      h2 class="c2c-nav-heading"
        "App"
      ul
        li
          a href="#/form/New_Contact"
            svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
              path
              path
              path
              path
              path
            span
              "New Contact"
        li
          a href="#/form/Person"
            svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
              path
              path
              path
              path
              path
            span
              "Person"
        li
          a aria-current="page" href="#/report/All_Contacts"
            svg aria-hidden="true" class="lucide lucide-table c2c-icon"
              path
              rect
              path
              path
            span
              "All Contacts"
  main tabindex="-1"
    section class="c2c-card" data-report="All_Contacts" data-view="list"
      h1
        "All Contacts"
      div class="c2c-report-tools"
        form class="c2c-search-form" role="search"
          label class="c2c-search"
            svg aria-hidden="true" class="lucide lucide-search"
              path
              circle
            input aria-label="Search All Contacts" placeholder="Search" type="search" value=""
          button class="button secondary sm" tabindex="0" type="submit"
            span class="labelSlot"
              span class="labelContent"
                span class="labelPhase"
                  "Search"
      div class="c2c-report-tools"
        label
          "Field to edit"
          select aria-label="Field to edit"
            option value=""
              "Choose a field"
            option value="Full_Name"
              "Full Name"
            option value="Email"
              "Email"
            option value="Kind"
              "Kind"
            option value="Birthday"
              "Birthday"
        label
          "New value"
          input aria-label="New value" disabled type="text" value=""
        button class="button secondary sm" disabled tabindex="0" type="button"
          span class="labelSlot"
            span class="labelContent"
              span class="labelPhase"
                "Edit 0 selected"
        span aria-live="polite"
          "Maximum 25 rows per batch."
      div class="table-wrap"
        div class="wrapper"
          div class="scroller"
            table class="table" role="table"
              caption
                "All Contacts"
              colgroup
                col
                col
                col
                col
                col
                col
                col
              thead role="rowgroup"
                tr role="row"
                  th data-key="__bulkSelect" role="columnheader" scope="col"
                    "Select"
                  th aria-sort="none" data-key="Full_Name" role="columnheader" scope="col"
                    button aria-label="Sort by Full Name" class="sortButton" type="button"
                      span class="sortInner"
                        span
                          "Full Name"
                        span aria-hidden="true" class="sortIcon"
                          svg aria-hidden="true" class="lucide lucide-arrow-up sortHint"
                            path
                            path
                          span class="sortArrow"
                            svg aria-hidden="true" class="lucide lucide-arrow-up"
                              path
                              path
                  th aria-sort="none" data-key="Email" role="columnheader" scope="col"
                    button aria-label="Sort by Email" class="sortButton" type="button"
                      span class="sortInner"
                        span
                          "Email"
                        span aria-hidden="true" class="sortIcon"
                          svg aria-hidden="true" class="lucide lucide-arrow-up sortHint"
                            path
                            path
                          span class="sortArrow"
                            svg aria-hidden="true" class="lucide lucide-arrow-up"
                              path
                              path
                  th aria-sort="none" data-key="Kind" role="columnheader" scope="col"
                    button aria-label="Sort by Kind" class="sortButton" type="button"
                      span class="sortInner"
                        span
                          "Kind"
                        span aria-hidden="true" class="sortIcon"
                          svg aria-hidden="true" class="lucide lucide-arrow-up sortHint"
                            path
                            path
                          span class="sortArrow"
                            svg aria-hidden="true" class="lucide lucide-arrow-up"
                              path
                              path
                  th aria-sort="none" data-key="Birthday" role="columnheader" scope="col"
                    button aria-label="Sort by Birthday" class="sortButton" type="button"
                      span class="sortInner"
                        span
                          "Birthday"
                        span aria-hidden="true" class="sortIcon"
                          svg aria-hidden="true" class="lucide lucide-arrow-up sortHint"
                            path
                            path
                          span class="sortArrow"
                            svg aria-hidden="true" class="lucide lucide-arrow-up"
                              path
                              path
                  th aria-sort="none" data-key="Owner_Ref" role="columnheader" scope="col"
                    button aria-label="Sort by Owner_Ref" class="sortButton" type="button"
                      span class="sortInner"
                        span
                          "Owner_Ref"
                        span aria-hidden="true" class="sortIcon"
                          svg aria-hidden="true" class="lucide lucide-arrow-up sortHint"
                            path
                            path
                          span class="sortArrow"
                            svg aria-hidden="true" class="lucide lucide-arrow-up"
                              path
                              path
                  th data-key="__actions" role="columnheader" scope="col"
                    "Actions"
              tbody role="rowgroup"
                tr role="row"
                  td data-phone="true" data-th="Select" role="cell"
                    input aria-label="Select record 1" type="checkbox"
                  td data-phone="true" data-th="Full Name" role="cell"
                    a href="#/report/All_Contacts/row/1"
                      "Ada Lovelace"
                  td data-phone="true" data-th="Email" role="cell"
                    "ada@example.com"
                  td data-phone="true" data-th="Kind" role="cell"
                    "Work"
                  td data-phone="true" data-th="Birthday" role="cell"
                    "10-Dec-1815"
                  td data-th="Owner_Ref" role="cell"
                    "–"
                  td data-phone="true" data-th="Actions" role="cell"
                    span class="c2c-row-actions"
                      a aria-label="Edit record 1" class="c2c-row-open" href="#/form/New_Contact/edit/1"
                        "Edit"
                      button class="button secondary sm" tabindex="0" type="button"
                        span class="labelSlot"
                          span class="labelContent"
                            span class="labelPhase"
                              "Delete"
                tr role="row"
                  td data-phone="true" data-th="Select" role="cell"
                    input aria-label="Select record 2" type="checkbox"
                  td data-phone="true" data-th="Full Name" role="cell"
                    a href="#/report/All_Contacts/row/2"
                      "Alan Turing"
                  td data-phone="true" data-th="Email" role="cell"
                    "alan@example.com"
                  td data-phone="true" data-th="Kind" role="cell"
                    "Friend"
                  td data-phone="true" data-th="Birthday" role="cell"
                    "23-Jun-1912"
                  td data-th="Owner_Ref" role="cell"
                    "–"
                  td data-phone="true" data-th="Actions" role="cell"
                    span class="c2c-row-actions"
                      a aria-label="Edit record 2" class="c2c-row-open" href="#/form/New_Contact/edit/2"
                        "Edit"
                      button class="button secondary sm" tabindex="0" type="button"
                        span class="labelSlot"
                          span class="labelContent"
                            span class="labelPhase"
                              "Delete"
          p class="srOnly" role="status"
  nav aria-label="Tabs"
    a href="#/form/New_Contact"
      svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
        path
        path
        path
        path
        path
      span
        "New Contact"
    a href="#/form/Person"
      svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
        path
        path
        path
        path
        path
      span
        "Person"
    a aria-current="page" href="#/report/All_Contacts"
      svg aria-hidden="true" class="lucide lucide-table c2c-icon"
        path
        rect
        path
        path
      span
        "All Contacts"
