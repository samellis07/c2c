app: contacts
route: #/report/All_Contacts
state: denied
viewport: phone 390
---
div class="c2c-app"
  header class="c2c-topbar"
    span
      "Contacts"
  nav aria-label="Main menu"
    div class="c2c-nav-section"
      h2 class="c2c-nav-heading"
        "App"
      ul
        li
          a href="#/form/New_Contact"
            svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
              path
              path
              path
              path
              path
            span
              "New Contact"
        li
          a href="#/form/Person"
            svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
              path
              path
              path
              path
              path
            span
              "Person"
        li
          a aria-current="page" href="#/report/All_Contacts"
            svg aria-hidden="true" class="lucide lucide-table c2c-icon"
              path
              rect
              path
              path
            span
              "All Contacts"
  main tabindex="-1"
    section class="c2c-card c2c-denied" role="alert"
      h1
        "You don't have access to"
        "All Contacts"
      p
        "Ask the app administrator for access."
      p
        a class="c2c-link" href="#/"
          "Go to home"
  nav aria-label="Tabs"
    a href="#/form/New_Contact"
      svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
        path
        path
        path
        path
        path
      span
        "New Contact"
    a href="#/form/Person"
      svg aria-hidden="true" class="lucide lucide-file-text c2c-icon"
        path
        path
        path
        path
        path
      span
        "Person"
    a aria-current="page" href="#/report/All_Contacts"
      svg aria-hidden="true" class="lucide lucide-table c2c-icon"
        path
        rect
        path
        path
      span
        "All Contacts"
