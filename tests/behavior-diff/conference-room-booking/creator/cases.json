  "cases": [
    {
      "id": "room-radio-initial-and-size-others",
      "name": "Add_Room: Available radio initial value Active applies; Size picklist has others option so Huge is accepted",
      "steps": [
        {
          "op": "submit",
          "form": "Add_Room",
          "record": {
            "Room_Name": "Orion",
            "Building_Floor": "Floor 2",
            "Location": {
              "address_line_1": "1 Test Way",
              "district_city": "Delta",
              "state_province": "Ridge",
              "postal_Code": "10001",
              "country": "United States"
            },
            "Size": "Huge",
            "Number_Of_Seats": 12
          },
          "expect": {
            "outcome": "saved"
          }
        }
      ],
      "expect": {
        "partial": true,
        "tables": {
          "Add_Room": [
            {
              "Room_Name": "Orion",
              "Size": "Huge",
              "Available": "Active",
              "Number_Of_Seats": "12",
              "Location_district_city": "Delta"
            }
          ]
        }
      }
    },
