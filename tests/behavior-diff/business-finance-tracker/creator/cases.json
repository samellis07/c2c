  "cases": [
    {
      "id": "account-unique-code",
      "name": "Add_Account_Details: must have unique Account_Code refuses a duplicate code",
      "steps": [
        {
          "op": "submit",
          "form": "Add_Currency",
          "record": {
            "Currency_Code": "Choice 1",
            "Currency": "Dollar"
          },
          "setup": true,
          "bind": {
            "cur": "body.values.ROWID"
          }
        },
        {
          "op": "submit",
          "form": "Account_Types",
          "record": {
            "Account_Type": "Bank",
            "Description": "Bank accounts"
          },
          "setup": true,
          "bind": {
            "atype": "body.values.ROWID"
          }
        },
        {
          "op": "submit",
          "form": "Add_Account_Details",
          "record": {
            "Account_Name": "Main",
            "Account_Code": "AC-1",
            "Account_Type": "<ref:atype>",
            "Currency": "<ref:cur>",
            "Open_Balance": "100.25",
            "Description": "Main account"
          },
          "setup": true
        },
        {
          "op": "submit",
          "form": "Add_Account_Details",
          "record": {
            "Account_Name": "Other",
            "Account_Code": "AC-1",
            "Account_Type": "<ref:atype>",
            "Currency": "<ref:cur>",
            "Open_Balance": "100.25",
            "Description": "Main account"
          },
          "expect": {
            "outcome": "refused"
          }
        }
      ],
      "expect": {
        "partial": true,
        "tables": {
          "Add_Account_Details": [
            {
              "Account_Code": "AC-1",
              "Account_Name": "Main"
            }
          ]
        }
      }
    },
