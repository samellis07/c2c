  "cases": [
    {
      "id": "completed-call-no-followup",
      "name": "Add_Call: valid completed call; On Validate clears Follow_up_Time and Follow_up_Notes when Follow_up_Required is No; datetime stored as yyyy-MM-dd HH:mm:ss",
      "steps": [
        {
          "op": "submit",
          "form": "Add_Sales_Rep",
          "record": {
            "Name": {
              "first_name": "Rae",
              "last_name": "Sol"
            },
            "Email": "rae.sol@example.com"
          },
          "setup": true,
          "bind": {
            "rep": "body.values.ROWID"
          }
        },
        {
          "op": "submit",
          "form": "Add_Customer",
          "record": {
            "Name": {
              "first_name": "Cy",
              "last_name": "Dune"
            },
            "Phone": "+1555010003",
            "Country": "Choice 1"
          },
          "setup": true,
          "bind": {
            "cust": "body.values.ROWID"
          }
        },
        {
          "op": "submit",
          "form": "Add_Call",
          "record": {
            "Type": "Completed Call",
            "Call_Direction": "Inbound",
            "Customer": "<ref:cust>",
            "Purpose_Of_Call": "Intro",
            "Follow_up_Required": "No",
            "Call_Start_Time": "01-Jan-2020 10:00:00",
            "Call_End_Time": "01-Jan-2020 10:30:00",
            "Call_Owner": "<ref:rep>",
            "Follow_up_Notes": "stale note"
          },
          "expect": {
            "outcome": "saved"
          }
        }
      ],
      "expect": {
        "partial": true,
        "tables": {
          "Add_Call": [
            {
              "Follow_up_Required": "No",
              "Follow_up_Notes": "",
              "Call_Start_Time": "2020-01-01 10:00:00",
              "Call_End_Time": "2020-01-01 10:30:00",
              "Type": "Completed Call"
            }
          ]
        }
      }
    },
