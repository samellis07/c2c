{
  "version": "c2c-behavior-golden/2",
  "app": "behavior-sample",
  "cases": [
    {
      "id": "submit-valid",
      "name": "a valid submit stores the row and the report reads it back",
      "steps": [
        {
          "op": "submit",
          "form": "Book",
          "record": { "Title": "Dune", "Qty": 2 },
          "expect": {
            "status": 200,
            "body": {
              "dryRun": false,
              "wrote": true,
              "values": {
                "Title": "Dune",
                "Qty": 2,
                "Added_User": "<any>",
                "Added_Time": "<timestamp>",
                "ID": "<id>",
                "ROWID": "<id>",
                "CREATEDTIME": "<timestamp>",
                "MODIFIEDTIME": "<timestamp>"
              }
            }
          }
        },
        {
          "op": "report",
          "report": "All_Books",
          "expect": {
            "status": 200,
            "body": {
              "dryRun": false,
              "rows": [
                {
                  "ROWID": "<id>",
                  "Title": "Dune",
                  "Qty": 2,
                  "Added_User": "<any>",
                  "Added_Time": "<timestamp>",
                  "Modified_Time": null
                }
              ],
              "fields": null,
              "queryShape": "SELECT ROWID, Title, Qty, Added_User, Added_Time, Modified_User, Modified_Time, c2c_source_id FROM Book ORDER BY ROWID LIMIT 1, 300",
              "criteria": { "op": "true" },
              "page": 0,
              "pageSize": 300
            }
          }
        }
      ],
      "expect": {
        "tables": {
          "Book": [
            {
              "Title": "Dune",
              "Qty": "2",
              "Added_User": "<any>",
              "Added_Time": "<timestamp>",
              "ROWID": "<id>",
              "CREATEDTIME": "<timestamp>",
              "MODIFIEDTIME": "<timestamp>"
            }
          ]
        }
      }
    },
    {
      "id": "submit-missing-mandatory",
      "name": "a submit without the mandatory Title is refused",
      "steps": [
        {
          "op": "submit",
          "form": "Book",
          "record": { "Qty": 1 },
          "expect": {
            "status": 422,
            "body": {
              "code": "MANDATORY_MISSING",
              "message": "field \"Title\" is required.",
              "dryRun": false,
              "requestId": "<any>",
              "field": "Title",
              "wrote": false
            }
          }
        }
      ],
      "expect": {
        "tables": {
          "Book": []
        }
      }
    }
  ]
}
