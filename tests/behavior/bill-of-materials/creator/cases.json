            "Mail_ID": "mail-id.689@example.com",
            "Phone": "+1555013901",
            "Role": "Technician/Designer"
          },
          "setup": true
        },
        {
          "op": "report",
          "report": "All_Users",
          "expect": {
            "outcome": "rows",
            "count": 1
          },
          "creator": {
            "code": 3000,
            "rows": 1
          }
        }
      ],
      "expect": {
        "partial": true,
        "tables": {
          "Add_User": [
            {
              "Mail_ID": "mail-id.689@example.com",
              "Phone": "+1555013901",
              "Role": "Technician/Designer",
              "Name_first_name": "Maple",
              "Name_last_name": "Bravo"
            }
          ]
        }
      },
      "notes": [
        "Creator's baseline read held one record left by the earlier session ('mail-id.689@example.com'); replayed as a setup write so the stored state matches the capture."
      ]
