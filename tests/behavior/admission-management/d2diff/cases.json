{
  "version": "c2c-behavior-golden/2",
  "app": "Admission Management",
  "cases": [
    {
      "id": "dept-mandatory-missing-refused",
      "tags": [
        "d2diff"
      ],
      "notes": [
        "Department_Name is 'must have unique' in Add_Department; an empty record is refused and nothing is stored"
      ],
      "steps": [
        {
          "op": "submit",
          "form": "Add_Department",
          "record": {},
          "expect": {
            "outcome": "refused"
          }
        }
      ],
      "expect": {
        "tables": {
          "Add_Department": []
        }
      }
    },
    {
      "id": "dept-unique-duplicate-refused",
      "tags": [
        "d2diff"
      ],
      "notes": [
        "must have unique Department_Name: second identical submit refused, one row kept"
      ],
      "steps": [
        {
          "op": "submit",
          "form": "Add_Department",
          "record": {
            "Department_Name": "Science"
          },
          "expect": {
            "outcome": "saved"
          }
        },
        {
          "op": "submit",
          "form": "Add_Department",
          "record": {
            "Department_Name": "Science"
          },
          "expect": {
            "outcome": "refused"
          }
        }
      ],
      "expect": {
        "partial": true,
        "tables": {
          "Add_Department": [
            {
              "Department_Name": "Science"
            }
          ]
        }
      }
    },
    {
      "id": "eligibility-pref-minimum-percent-mandatory",
      "tags": [
        "d2diff"
      ],
      "notes": [
        "Minimum_Percent is a must-have percentage: omitted -> refused, nothing written"
      ],
      "steps": [
        {
          "op": "submit",
          "form": "Add_Department",
          "record": {
            "Department_Name": "Science"
          },
          "bind": {
            "d": "body.values.ROWID"
          },
          "setup": true
        },
        {
          "op": "submit",
          "form": "Add_Division",
          "record": {
            "Division_Name": "Morning"
          },
          "bind": {
            "dv": "body.values.ROWID"
          },
          "setup": true
        },
        {
          "op": "submit",
          "form": "Add_Course",
          "record": {
            "Department": "<ref:d>",
            "Course_Name": "Physics",
            "Divisions": [
              "<ref:dv>"
            ]
          },
          "bind": {
            "c": "body.values.ROWID"
          },
          "setup": true
        },
        {
          "op": "submit",
          "form": "Start_New_Admission",
          "record": {
            "Course": "<ref:c>",
            "Division": "<ref:dv>",
            "Course_Period": "P1",
            "Department": "<ref:d>",
            "Required_Seats": 30,
            "Max_No_Of_Applications": 60,
            "Admission_Deadline": "2027-01-15 10:30:00"
          },
          "bind": {
            "a": "body.values.ROWID"
          },
          "setup": true
        },
        {
          "op": "submit",
          "form": "Add_Eligibility_Course",
          "record": {
            "Course_Name": "Physics"
          },
          "bind": {
            "ec": "body.values.ROWID"
          },
          "setup": true
        },
        {
          "op": "submit",
          "form": "Add_Eligibility_Preference",
          "record": {
            "Choose_Course": "<ref:ec>",
            "Course_Admission_Id": "<ref:a>"
          },
          "expect": {
            "outcome": "refused"
          },
          "tags": [
            "api-only-acceptance"
          ],
          "apiOnly": [
            "Course_Admission_Id"
          ]
        }
      ],
      "expect": {
        "tables": {
          "Add_Eligibility_Preference": []
        }
      }
    },
