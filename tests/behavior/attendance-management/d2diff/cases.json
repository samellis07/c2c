{
  "version": "c2c-behavior-golden/2",
  "app": "Attendance Management",
  "cases": [
    {
      "id": "class-title-unique-and-days-meet-mandatory",
      "notes": [
        "Add_Class: must have unique Class_Title, must have Days_Meet (checkboxes)"
      ],
      "steps": [
        {
          "op": "submit",
          "form": "Add_Class",
          "record": {
            "Class_Title": "Maths",
            "Date_unbounded": true
          },
          "expect": {
            "outcome": "refused"
          }
        },
        {
          "op": "submit",
          "form": "Add_Class",
          "record": {
            "Class_Title": "Maths",
            "Days_Meet": [
              "Monday"
            ],
            "Date_unbounded": true
          },
          "expect": {
            "outcome": "saved"
          }
        },
        {
          "op": "submit",
          "form": "Add_Class",
          "record": {
            "Class_Title": "Maths",
            "Days_Meet": [
              "Tuesday"
            ],
            "Date_unbounded": true
          },
          "expect": {
            "outcome": "refused"
          }
        }
      ],
      "expect": {
        "partial": true,
        "tables": {
          "Add_Class": [
            {
              "Class_Title": "Maths"
            }
          ]
        }
      },
      "tags": [
        "d2diff"
      ]
    },
    {
      "id": "class-bounded-without-dates-cancel-submit",
      "notes": [
        "Validation script (on add, Date_unbounded == false): Starting_Date or Ending_Date null -> cancel submit. Date_unbounded initial value is false, so omitting it takes the bounded path"
      ],
      "steps": [
        {
          "op": "submit",
          "form": "Add_Class",
          "record": {
            "Class_Title": "Maths",
            "Days_Meet": [
              "Monday"
            ]
          },
          "expect": {
            "outcome": "refused"
          }
        }
      ],
      "expect": {
        "tables": {
          "Add_Class": []
        }
      },
      "tags": [
        "d2diff"
      ]
    },
    {
      "id": "class-bounded-explicit-false-without-dates-cancel-submit",
      "notes": [
        "same as the omitted-default case with Date_unbounded sent as false"
      ],
      "steps": [
        {
          "op": "submit",
          "form": "Add_Class",
          "record": {
            "Class_Title": "Maths",
            "Days_Meet": [
              "Monday"
            ],
            "Date_unbounded": false
          },
          "expect": {
            "outcome": "refused"
          }
        }
      ],
      "expect": {
        "tables": {
          "Add_Class": []
        }
      },
      "tags": [
        "d2diff"
      ]
    },
    {
      "id": "class-bounded-with-dates-and-status-initial-active",
      "notes": [
        "bounded class with both dates saves; Class_Status initial value Active"
      ],
      "steps": [
        {
          "op": "submit",
          "form": "Add_Class",
          "record": {
            "Class_Title": "Maths",
            "Days_Meet": [
              "Monday"
            ],
            "Starting_Date": "2026-09-01",
            "Ending_Date": "2027-06-30"
          },
          "expect": {
            "outcome": "saved"
          }
        }
      ],
      "expect": {
        "partial": true,
        "tables": {
          "Add_Class": [
            {
              "Class_Title": "Maths",
              "Class_Status": "Active",
              "Date_unbounded": false
            }
          ]
        }
      },
      "tags": [
        "d2diff"
      ]
    },
    {
      "id": "class-unbounded-without-dates-saved",
      "notes": [
        "Date_unbounded true skips the dates validation"
      ],
      "steps": [
        {
          "op": "submit",
          "form": "Add_Class",
          "record": {
            "Class_Title": "Maths",
