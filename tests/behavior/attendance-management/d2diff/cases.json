            {
              "Class_Title": "Maths",
              "Date_unbounded": true
            }
          ]
        }
      },
      "tags": [
        "d2diff"
      ]
    },
    {
      "id": "student-defaults-gender-status",
      "notes": [
        "initial values Gender = Male and Student_Status = Active (Gender sent explicitly in other cases)"
      ],
      "steps": [
        {
          "op": "submit",
          "form": "Add_Student",
          "record": {
            "Student_Name": {
              "first_name": "Stu",
              "last_name": "Lee"
            },
            "Date_of_Birth": "2012-05-04",
            "Photo": {
              "key": "k1"
            },
            "Parent_Name1": {
              "first_name": "Par",
              "last_name": "Lee"
            },
            "Parent_Email": "p@example.test"
          },
          "expect": {
            "outcome": "saved"
          }
        }
      ],
      "expect": {
        "partial": true,
        "tables": {
          "Add_Student": [
            {
              "Gender": "Male",
              "Student_Status": "Active"
            }
          ]
        }
      },
      "skip": "Add_Student has must-have Photo (image); the only accepted write shape {key} answers 500 in the offline harness, so the form is unreachable via the API (see student-photo-file-reference-saved)",
      "tags": [
        "d2diff",
        "unreachable-via-api"
      ]
    },
    {
      "id": "student-registration-number-sequence",
      "notes": [
        "On Success: first student Registration_Number = 1; later max(Registration_Number) + 1 -> 2 [UNVERIFIED] for the later one: the script only sets input.Registration_Number after the insert"
      ],
      "tags": [
        "d2diff",
        "unreachable-via-api"
      ],
      "steps": [
        {
          "op": "submit",
          "form": "Add_Student",
          "record": {
            "Student_Name": {
              "first_name": "Stu1",
              "last_name": "Lee"
            },
            "Date_of_Birth": "2012-05-04",
            "Photo": {
              "key": "k1"
            },
            "Parent_Name1": {
              "first_name": "Par",
              "last_name": "Lee"
            },
            "Parent_Email": "p1@example.test",
            "Email": "a@example.test",
            "Gender": "Female"
          },
          "setup": true
        },
        {
          "op": "submit",
          "form": "Add_Student",
          "record": {
            "Student_Name": {
              "first_name": "Stu2",
              "last_name": "Lee"
            },
            "Date_of_Birth": "2012-05-04",
            "Photo": {
              "key": "k1"
            },
            "Parent_Name1": {
              "first_name": "Par",
              "last_name": "Lee"
            },
            "Parent_Email": "p2@example.test",
            "Email": "b@example.test",
            "Gender": "Female"
          },
          "setup": true
        }
      ],
      "expect": {
        "partial": true,
        "tables": {
          "Add_Student": [
            {
              "Email": "a@example.test",
              "Registration_Number": 1
            },
            {
              "Email": "b@example.test",
              "Registration_Number": 2
            }
          ]
        }
      },
      "skip": "Add_Student has must-have Photo (image); the only accepted write shape {key} answers 500 in the offline harness, so the form is unreachable via the API (see student-photo-file-reference-saved)"
    },
