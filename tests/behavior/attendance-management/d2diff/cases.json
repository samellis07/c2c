    {
      "id": "attendance-present-and-absent-counts-on-success",
      "notes": [
        "On success: Absent_Students = class students not in Present_Students; Number_Of_Present_Students = size(Present_Students), Number_Of_Absent_Students = size(absent)"
      ],
      "steps": [
        {
          "op": "submit",
          "form": "Add_Student",
          "record": {
            "Student_Name": {
              "first_name": "Stu1",
              "last_name": "Lee"
            },
            "Date_of_Birth": "2012-05-04",
            "Photo": {
              "key": "k1"
            },
            "Parent_Name1": {
              "first_name": "Par",
              "last_name": "Lee"
            },
            "Parent_Email": "p1@example.test",
            "Email": "a@example.test",
            "Gender": "Female"
          },
          "bind": {
            "s1": "body.values.ROWID"
          },
          "setup": true
        },
        {
          "op": "submit",
          "form": "Add_Student",
          "record": {
            "Student_Name": {
              "first_name": "Stu2",
              "last_name": "Lee"
            },
            "Date_of_Birth": "2012-05-04",
            "Photo": {
              "key": "k1"
            },
            "Parent_Name1": {
              "first_name": "Par",
              "last_name": "Lee"
            },
            "Parent_Email": "p2@example.test",
            "Email": "b@example.test",
            "Gender": "Female"
          },
          "bind": {
            "s2": "body.values.ROWID"
          },
          "setup": true
        },
        {
          "op": "submit",
          "form": "Add_Class",
          "record": {
            "Class_Title": "Maths",
            "Days_Meet": [
              "Monday"
            ],
            "Date_unbounded": true,
            "Students": [
              "<ref:s1>",
              "<ref:s2>"
            ]
          },
          "bind": {
            "c": "body.values.ROWID"
          },
          "setup": true
        },
        {
          "op": "submit",
          "form": "Fill_Attendance",
          "record": {
            "Attendance_Date": "2026-10-05",
            "Class": "<ref:c>",
            "Present_Students": [
              "<ref:s1>"
            ]
          },
          "expect": {
            "outcome": "saved"
          }
        }
      ],
      "expect": {
        "partial": true,
        "tables": {
          "Fill_Attendance": [
            {
              "Class": "<ref:c>",
              "Number_Of_Present_Students": 1,
              "Number_Of_Absent_Students": 1
            }
          ]
        }
      },
      "skip": "Add_Student has must-have Photo (image); the only accepted write shape {key} answers 500 in the offline harness, so the form is unreachable via the API (see student-photo-file-reference-saved)",
      "tags": [
        "d2diff",
        "unreachable-via-api"
      ]
    },
