{
  "version": "c2c-behavior-golden/2",
  "app": "Assignment Tracker",
  "cases": [
    {
      "id": "assignment-issued-after-due-cancel-submit",
      "notes": [
        "on validate: Issued_Date > Due_Date -> cancel submit"
      ],
      "steps": [
        {
          "op": "submit",
          "form": "Add_Assignment_Type",
          "record": {
            "Type": "Essay"
          },
          "setup": true,
          "bind": {
            "t": "body.values.ROWID"
          }
        },
        {
          "op": "submit",
          "form": "Add_Class",
          "record": {
            "Name": "Class A"
          },
          "setup": true,
          "bind": {
            "cl": "body.values.ROWID"
          }
        },
        {
          "op": "submit",
          "form": "Add_Student",
          "record": {
            "Student_ID": "S1",
            "Name": {
              "first_name": "Ann",
              "last_name": "Lee"
            },
            "Email": "s1@example.test",
            "Phone_Number": "+15550100",
            "Class": "<ref:cl>"
          },
          "setup": true,
          "bind": {
            "stu": "body.values.ROWID"
          }
        },
        {
          "op": "submit",
          "form": "Add_Subject",
          "record": {
            "Name": "Math",
            "Code": "M1",
            "Type": "Theory"
          },
          "setup": true,
          "bind": {
            "sub": "body.values.ROWID"
          }
        },
        {
          "op": "submit",
          "form": "Add_Teacher",
          "record": {
            "Teacher_ID": "T1",
            "Name": {
              "first_name": "Bo",
              "last_name": "Kay"
            },
            "Email": "t1@example.test",
            "Phone_Number": "+15550101"
          },
          "setup": true,
          "bind": {
            "tch": "body.values.ROWID"
          }
        },
        {
          "op": "submit",
          "form": "Create_Assignment",
          "record": {
            "Title": "Essay one",
            "Subject_field": "<ref:sub>",
            "Assignment_Type": "<ref:t>",
            "Class": "<ref:cl>",
            "Issued_Date": "2026-10-20",
            "Due_Date": "2026-10-16",
            "Faculty": "<ref:tch>",
            "Allocated_To": [
              "<ref:stu>"
            ]
          },
          "expect": {
            "outcome": "refused"
          }
        }
      ],
      "expect": {
        "tables": {
          "Create_Assignment": []
        }
      },
      "tags": [
        "d2diff"
      ]
    },
