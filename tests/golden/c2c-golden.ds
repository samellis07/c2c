				row = 1
				column = 1
				width = medium
			)
			Status
			(
				type = text
				displayname = "Status"
				row = 1
				column = 1
				width = medium
			)
			Billable
			(
				type = checkbox
				displayname = "Billable"
				initial value = false
				row = 1
				column = 1
				width = medium
			)
			Approved
			(
				type = checkbox
				displayname = "Approved"
				initial value = false
				row = 1
				column = 1
				width = medium
			)
			actions
			{
				on add
				{
					submit
					(
						type = submit
						displayname = "Submit"
					)
					reset
					(
						type = reset
						displayname = "Reset"
					)
				}
				on edit
