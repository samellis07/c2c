						enc_4 = "{\"$error\":\"" + msg + "\"}";
						frag = frag + ",\"sort.foreach-desc\":" + enc_4;
						info "c2c\tsort.foreach-desc\t" + enc_4;
					}
					// criteria.bare-and [form, bare-name] kind=list
					try
					{
						rows_5 = FlagRow[Status == "Open" && Billable && Approved] sort by Name;
						golden_5 = rows_5.Name.getAll();
						if(isNull(golden_5))
						{
							enc_5 = "null";
						}
						else
						{
							out_5 = "[";
							i_5 = 0;
							for each item_5 in golden_5
							{
								if(i_5 > 0)
								{
									out_5 = out_5 + ",";
								}
								if(isNull(item_5))
								{
									out_5 = out_5 + "null";
								}
								else
								{
									tmp_5 = "" + item_5;
									tmp_5 = tmp_5.replaceAll("\\", "\\\\");
									tmp_5 = tmp_5.replaceAll("\"", "\\\"");
									out_5 = out_5 + "\"" + tmp_5 + "\"";
								}
								i_5 = i_5 + 1;
							}
							enc_5 = out_5 + "]";
						}
						frag = frag + ",\"criteria.bare-and\":" + enc_5;
						info "c2c\tcriteria.bare-and\t" + enc_5;
					}
					catch (err)
					{
						msg = "" + err;
						msg = msg.replaceAll("\\", "\\\\");
						msg = msg.replaceAll("\"", "\\\"");
						enc_5 = "{\"$error\":\"" + msg + "\"}";
						frag = frag + ",\"criteria.bare-and\":" + enc_5;
						info "c2c\tcriteria.bare-and\t" + enc_5;
					}
					// criteria.bare-false [form, bare-name, false] kind=list
					try
					{
						rows_6 = FlagRow[Qty != 99 && Billable == false] sort by Name;
						golden_6 = rows_6.Name.getAll();
						if(isNull(golden_6))
						{
							enc_6 = "null";
						}
						else
						{
							out_6 = "[";
							i_6 = 0;
							for each item_6 in golden_6
							{
								if(i_6 > 0)
								{
									out_6 = out_6 + ",";
								}
								if(isNull(item_6))
								{
									out_6 = out_6 + "null";
								}
								else
								{
									tmp_6 = "" + item_6;
									tmp_6 = tmp_6.replaceAll("\\", "\\\\");
									tmp_6 = tmp_6.replaceAll("\"", "\\\"");
									out_6 = out_6 + "\"" + tmp_6 + "\"";
								}
								i_6 = i_6 + 1;
							}
							enc_6 = out_6 + "]";
						}
						frag = frag + ",\"criteria.bare-false\":" + enc_6;
						info "c2c\tcriteria.bare-false\t" + enc_6;
					}
					catch (err)
					{
						msg = "" + err;
						msg = msg.replaceAll("\\", "\\\\");
						msg = msg.replaceAll("\"", "\\\"");
						enc_6 = "{\"$error\":\"" + msg + "\"}";
						frag = frag + ",\"criteria.bare-false\":" + enc_6;
						info "c2c\tcriteria.bare-false\t" + enc_6;
					}
					// criteria.var-ne [form, variable] kind=list
					try
					{
						skip_7 = "Ada";
						rows_7 = GoldenRow[Name != skip_7 && Status == "Open"] sort by Qty;
						golden_7 = rows_7.Name.getAll();
						if(isNull(golden_7))
						{
							enc_7 = "null";
						}
						else
						{
							out_7 = "[";
							i_7 = 0;
							for each item_7 in golden_7
							{
								if(i_7 > 0)
								{
									out_7 = out_7 + ",";
								}
								if(isNull(item_7))
								{
									out_7 = out_7 + "null";
								}
								else
								{
									tmp_7 = "" + item_7;
									tmp_7 = tmp_7.replaceAll("\\", "\\\\");
									tmp_7 = tmp_7.replaceAll("\"", "\\\"");
									out_7 = out_7 + "\"" + tmp_7 + "\"";
								}
								i_7 = i_7 + 1;
							}
							enc_7 = out_7 + "]";
						}
						frag = frag + ",\"criteria.var-ne\":" + enc_7;
						info "c2c\tcriteria.var-ne\t" + enc_7;
					}
					catch (err)
					{
						msg = "" + err;
						msg = msg.replaceAll("\\", "\\\\");
						msg = msg.replaceAll("\"", "\\\"");
						enc_7 = "{\"$error\":\"" + msg + "\"}";
						frag = frag + ",\"criteria.var-ne\":" + enc_7;
						info "c2c\tcriteria.var-ne\t" + enc_7;
					}
					// getall.bare-field [form, bare-name] kind=list
					try
					{
						rows_8 = FlagRow[Billable == true] sort by Name;
						golden_8 = rows_8.Name.getAll();
						if(isNull(golden_8))
						{
							enc_8 = "null";
						}
						else
						{
							out_8 = "[";
							i_8 = 0;
							for each item_8 in golden_8
							{
								if(i_8 > 0)
								{
									out_8 = out_8 + ",";
								}
								if(isNull(item_8))
								{
									out_8 = out_8 + "null";
								}
								else
								{
									tmp_8 = "" + item_8;
									tmp_8 = tmp_8.replaceAll("\\", "\\\\");
									tmp_8 = tmp_8.replaceAll("\"", "\\\"");
									out_8 = out_8 + "\"" + tmp_8 + "\"";
								}
								i_8 = i_8 + 1;
							}
							enc_8 = out_8 + "]";
						}
						frag = frag + ",\"getall.bare-field\":" + enc_8;
						info "c2c\tgetall.bare-field\t" + enc_8;
					}
					catch (err)
					{
						msg = "" + err;
						msg = msg.replaceAll("\\", "\\\\");
						msg = msg.replaceAll("\"", "\\\"");
						enc_8 = "{\"$error\":\"" + msg + "\"}";
						frag = frag + ",\"getall.bare-field\":" + enc_8;
						info "c2c\tgetall.bare-field\t" + enc_8;
					}
					return frag;
				}

				// ------------------------------------------------------------
				// Function name: c2c_golden_capture_residual
				// Return type: String
				// Arguments: none
				// Execute THIS after GoldenRow has the four section-3 rows and FlagRow has the four rows in tests/golden/criteria-data.json. It calls thisapp.c2c_golden_part_19 only. Do not re-run c2c_golden_capture or c2c_golden_capture_recapture. Save the return as $C2C_FIXTURES_DIR/golden/residual.json.
				// Paste this whole block. If the editor already wrote the signature, keep one signature and one pair of braces.
				// ------------------------------------------------------------
				string c2c_golden_capture_residual()
				{
					out = "{" + thisapp.c2c_golden_part_19();
					return out + "}";
				}

		}
	}

