application "c2c-golden"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Calcutta"
	time format = "24-hr"

	forms
	{
		form GoldenRow
		{
			displayname = "GoldenRow"
			Name
			(
				type = text
				displayname = "Name"
				row = 1
				column = 1
				width = medium
			)
			Qty
			(
				type = number
				displayname = "Qty"
				row = 1
				column = 1
				width = medium
			)
			Status
			(
				type = text
				displayname = "Status"
				row = 1
				column = 1
				width = medium
			)
			Tag
			(
				type = picklist
				displayname = "Tag"
				values = {"Open","Hold"}
				row = 1
				column = 1
				width = medium
			)
			actions
			{
				on add
				{
					submit
					(
						type = submit
						displayname = "Submit"
					)
					reset
					(
						type = reset
						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
						type = submit
						displayname = "Update"
					)
					cancel
					(
						type = cancel
						displayname = "Cancel"
					)
				}
			}
		}
		form FlagRow
		{
			displayname = "FlagRow"
			Name
			(
				type = text
				displayname = "Name"
				row = 1
				column = 1
				width = medium
			)
