				// ------------------------------------------------------------
				// Function name: c2c_golden_capture_recapture
				// Return type: String
				// Arguments: none
				// Execute THIS to re-capture only the 42 boolean cases. The main capture cannot encode them. Do not re-run c2c_golden_capture. Save this return as $C2C_FIXTURES_DIR/golden/recapture.json.
				// Paste this whole block. If the editor already wrote the signature, keep one signature and one pair of braces.
				// ------------------------------------------------------------
				string c2c_golden_capture_recapture()
				{
					out = "{" + thisapp.c2c_golden_part_recapture();
					return out + "}";
				}

				// ------------------------------------------------------------
				// Function name: c2c_golden_data
				// Return type: String
				// Arguments: none
				// Execute only after the GoldenRow form and the four seed rows exist.
				// Paste this whole block. If the editor already wrote the signature, keep one signature and one pair of braces.
				// ------------------------------------------------------------
				string c2c_golden_data()
				{
					frag = "";
					// getall.names-qty-positive [form] kind=list
					try
					{
						golden_1 = GoldenRow[Qty > 0].Name.getAll();
						if(isNull(golden_1))
						{
							enc_1 = "null";
						}
						else
						{
							out_1 = "[";
							i_1 = 0;
							for each item_1 in golden_1
							{
								if(i_1 > 0)
								{
									out_1 = out_1 + ",";
								}
								if(isNull(item_1))
								{
									out_1 = out_1 + "null";
								}
								else
								{
									tmp_1 = "" + item_1;
									tmp_1 = tmp_1.replaceAll("\\", "\\\\");
									tmp_1 = tmp_1.replaceAll("\"", "\\\"");
									out_1 = out_1 + "\"" + tmp_1 + "\"";
								}
								i_1 = i_1 + 1;
							}
							enc_1 = out_1 + "]";
						}
						frag = frag + "\"getall.names-qty-positive\":" + enc_1;
						info "c2c\tgetall.names-qty-positive\t" + enc_1;
					}
					catch (err)
					{
						msg = "" + err;
						msg = msg.replaceAll("\\", "\\\\");
						msg = msg.replaceAll("\"", "\\\"");
