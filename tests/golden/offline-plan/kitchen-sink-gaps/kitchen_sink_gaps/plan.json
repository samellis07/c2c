{
  "version": 1,
  "command": "plan",
  "c2c": "0.2.0",
  "app": "Archive_Intake_Gaps",
  "dc": "in",
  "dcSource": "--dc",
  "doctor": "not-run",
  "counts": {
    "tables": 1,
    "dataStoreTables": 1,
    "columns": 14,
    "nosqlTables": 0,
    "functions": 0,
    "schedules": 0,
    "reports": 0,
    "pages": 0,
    "roles": 0,
    "customApis": 0
  },
  "tables": [
    {
      "name": "Artifact_Intake",
      "form": "Artifact_Intake",
      "role": "form",
      "nosql": false,
      "columns": 14,
      "uniqueVarchar": 0,
      "fks": 0
    }
  ],
  "fieldGaps": [
    {
      "matrixId": "barcode",
      "count": 1,
      "reason": "Creator builds the code from static text plus other fields. The column stores that payload. The renderer is not a Data Store type. At most two per form in Creator; this step does not enforce the cap beyond reporting the field.",
      "fields": [
        {
          "form": "Artifact_Intake",
          "field": "Shelf_Code"
        }
      ]
    },
    {
      "matrixId": "geolocation",
      "count": 1,
      "reason": "Not a Creator field type. Latitude and longitude exist only inside Address (and Added/Modified Location). No geo column is invented for this token. If a source still says geolocation, it is reported unsupported.",
      "fields": [
        {
          "form": "Artifact_Intake",
          "field": "Site_Location"
        }
      ]
    },
    {
      "matrixId": "integration",
      "count": 1,
      "reason": "Needs a Connection the owner authorizes later. The column stores the external id or display text. The fetch is not generated by the schema step.",
      "fields": [
        {
          "form": "Artifact_Intake",
          "field": "External_Record"
        }
      ]
    },
    {
      "matrixId": "keyword",
      "count": 1,
      "reason": "Not a column that fills itself. Text stores the Zia result of a post-submit call. The call is not part of this schema step.",
      "fields": [
        {
          "form": "Artifact_Intake",
          "field": "Extracted_Terms"
        }
      ]
    },
    {
      "matrixId": "legacy-crm",
      "count": 1,
      "reason": "Pre-Creator 5 display value (API type 22). Text column. The CRM connection is owner-later and is not created here.",
      "fields": [
        {
          "form": "Artifact_Intake",
          "field": "Old_Crm_Reference"
        }
      ]
    },
    {
      "matrixId": "legacy-crm-link",
      "count": 1,
      "reason": "Pre-Creator 5 record id (API type 23). Bigint column. The CRM connection is owner-later.",
      "fields": [
        {
          "form": "Artifact_Intake",
          "field": "Old_Crm_Record"
        }
      ]
    },
    {
      "matrixId": "object-detection",
      "count": 1,
      "reason": "Text holds post-submit labels. Not a column that fills itself.",
      "fields": [
        {
          "form": "Artifact_Intake",
          "field": "Detected_Objects"
        }
      ]
    },
    {
      "matrixId": "ocr",
      "count": 1,
      "reason": "Text holds a post-submit Zia OCR result. Depends on the image living in Stratus. Not self-filling.",
      "fields": [
        {
          "form": "Artifact_Intake",
          "field": "Text_From_Image"
        }
      ]
    },
    {
      "matrixId": "prediction",
      "count": 1,
      "reason": "Needs a trained Zia model. No column is generated. Not-yet-tried as a generated field.",
      "fields": [
        {
          "form": "Artifact_Intake",
          "field": "Forecast"
        }
      ]
    },
    {
      "matrixId": "sentiment",
      "count": 1,
      "reason": "Same as keyword extraction: text holds a post-submit Zia result. Not self-filling.",
      "fields": [
        {
          "form": "Artifact_Intake",
          "field": "Tone_Result"
        }
      ]
    }
  ],
  "budgets": [
    {
      "id": "columns",
      "table": "Artifact_Intake",
      "status": "pass",
      "detail": "table Artifact_Intake: 14/250 columns"
    },
    {
      "id": "unique-varchar",
      "table": "Artifact_Intake",
      "status": "pass",
      "detail": "table Artifact_Intake: 0/2 unique varchar columns"
    },
    {
      "id": "fk",
      "table": "Artifact_Intake",
      "status": "pass",
      "detail": "table Artifact_Intake: 0/15 foreign keys"
    },
    {
      "id": "select-width",
      "table": "Artifact_Intake",
      "status": "pass",
      "detail": "widest generated read of Artifact_Intake selects 14 columns per statement (docs 20, unverified limit 30; confirm with P-WIDTH)"
    },
    {
      "id": "joins",
      "status": "pass",
      "detail": "generated reads are single-table (0/4 joins); lookup display needs one fetch per lookup (confirm with P-JOIN)"
    },
    {
      "id": "org-tables",
      "status": "pass",
      "detail": "this app creates 1 Data Store table(s); an org-wide limit on table creates refuses a create with 403 API_LIMIT_REACHED \"API Limit for table\" — on that refusal stop creates, keep created tables, and retry after 30/60/120 minutes; a project delete may not free capacity at once"
    },
    {
      "id": "dev-row-cap",
      "status": "warn",
      "detail": "the per-table row estimate needs source row counts; Development's per-table row cap is a hidden value (datastore.rows_per_table_dev, the value is not published) — a load refused with 403 API_LIMIT_REACHED \"API Limit for row\" is the signal",
      "fix": "re-run c2c plan with --source-backup, --source-csv or --source-json so the budget lists the largest tables; rehearse a large load on a different environment before cutover"
    },
    {
      "id": "varchar-length",
      "status": "warn",
      "detail": "source string values are unmeasured; a REST insert silently truncates past a varchar column's length (measured ceiling 255) — validate before write; counts are JavaScript code points — whether Catalyst counts emoji, multibyte characters or CRLF line endings the same way is unverified",
      "fix": "re-run c2c plan with --source-backup, --source-csv or --source-json so the budget measures source string values against varchar column lengths"
    },
    {
      "id": "dev-api-calls",
      "status": "warn",
      "detail": "the mover's API-call estimate needs source row counts; Development allows 200000 API calls per application (api.calls_dev, docs figure)",
      "fix": "re-run c2c plan with --source-backup, --source-csv or --source-json so the estimate counts the mover reads and writes"
    },
    {
      "id": "dev-write-rate",
      "status": "pass",
      "detail": "no source row counts — the dev-api-calls budget carries the missing-source warning; the stated Development write rate is ~100 writes/min/table (datastore.write_requests_per_minute, unverified)",
      "fix": "re-run c2c plan with --source-backup, --source-csv or --source-json so both estimates count the mover calls; run c2c probe P-RATE before a large load"
    }
  ],
  "budgetsOk": true,
  "steps": [
    {
      "id": "import",
      "via": "cli",
      "command": "c2c provision --confirm --run import",
      "args": {
        "name": "c2c-archive-intake-gaps",
        "environment": "Development",
        "app": "Archive_Intake_Gaps",
        "dir": "provision/iac",
        "note": "the bundle ships the dry-run c2c_api without bundled dependencies — run c2c deploy --confirm after provisioning to install the live function"
      },
      "readBack": {
        "via": "cli",
        "command": "c2c provision --record import",
        "match": {
          "project_name": "<import-name>",
          "id": "<project>"
        }
      }
    },
    {
      "id": "cloudscale-enable",
      "via": "console",
      "command": "Catalyst console → the project → Cloud Scale → Start Exploring (<console>/baas/<org>/project/<project>/Development#/cloudscale) — then c2c verifies it: c2c provision --record cloudscale-enable (GET /baas/v1/project/<project>/table)",
      "args": {
        "service": "Cloud Scale"
      },
      "readBack": {
        "via": "cli",
        "command": "c2c provision --record cloudscale-enable",
        "args": {
          "call": {
            "method": "GET",
            "path": "/baas/v1/project/<project>/table"
          }
        },
        "match": {
          "gate": "open"
        }
      }
    },
    {
      "id": "tables",
      "via": "cli",
      "command": "c2c provision --confirm --run tables",
      "args": {
        "plan": "provision/tables.json",
        "tables": [
          "Artifact_Intake"
        ]
      },
      "readBack": {
        "via": "mcp",
        "tool": "CatalystbyZoho_List_All_Tables",
        "match": {
          "table_name": [
            "Artifact_Intake"
          ]
        }
      }
    },
    {
      "id": "import-table-permissions",
      "via": "mcp",
      "tool": "CatalystbyZoho_Get_Table_Permissions",
      "args": {
        "path_variables": {
          "projectId": "<project>"
        },
        "headers": {
          "Catalyst-org": "<org>",
          "Environment": "Development"
        },
        "calls": [
          {
            "path_variables": {
              "id": "<id:Artifact_Intake>"
            }
          }
        ],
        "note": "the IaC import set these grants; this step only proves them — a mismatch means the import did not apply them"
      },
      "readBack": {
        "via": "mcp",
        "tool": "CatalystbyZoho_Get_Table_Permissions",
        "args": {
          "path_variables": {
            "projectId": "<project>"
          },
          "headers": {
            "Catalyst-org": "<org>",
            "Environment": "Development"
          },
          "calls": [
            {
              "path_variables": {
                "id": "<id:Artifact_Intake>"
              }
            }
          ]
        },
        "match": {
          "<id:Artifact_Intake>": {
            "App Administrator": [
              "SELECT",
              "UPDATE",
              "INSERT",
              "DELETE"
            ],
            "App User": [
              "SELECT"
            ]
          }
        }
      }
    },
    {
      "id": "import-table-scopes",
      "via": "mcp",
      "tool": "CatalystbyZoho_Get_Table_Scopes",
      "args": {
        "path_variables": {
          "projectId": "<project>"
        },
        "headers": {
          "Catalyst-org": "<org>",
          "Environment": "Development"
        },
        "calls": [
          {
            "path_variables": {
              "id": "<id:Artifact_Intake>"
            }
          }
        ],
        "note": "the IaC import set these scopes; this step only proves them"
      },
      "readBack": {
        "via": "mcp",
        "tool": "CatalystbyZoho_Get_Table_Scopes",
        "args": {
          "path_variables": {
            "projectId": "<project>"
          },
          "headers": {
            "Catalyst-org": "<org>",
            "Environment": "Development"
          },
          "calls": [
            {
              "path_variables": {
                "id": "<id:Artifact_Intake>"
              }
            }
          ]
        },
        "match": {
          "<id:Artifact_Intake>": {
            "App Administrator": [
              "GLOBAL"
            ],
            "App User": [
              "GLOBAL"
            ]
          }
        }
      }
    },
    {
      "id": "import-security-rule",
      "via": "mcp",
      "tool": "CatalystbyZoho_List_All_Functions",
      "args": {
        "path_variables": {
          "projectId": "<project>"
        },
        "headers": {
          "Catalyst-org": "<org>",
          "Environment": "Development"
        },
        "note": "the IaC SecurityRules item requires authentication for c2c_api; List_All_Functions exposes is_authenticated — this step only proves the import applied it"
      },
      "readBack": {
        "via": "mcp",
        "tool": "CatalystbyZoho_List_All_Functions",
        "match": {
          "c2c_api": {
            "is_authenticated": true
          }
        }
      }
    }
  ],
  "mcpTools": {
    "base": [
      "CatalystbyZoho_List_All_Organizations",
      "CatalystbyZoho_List_All_Tables",
      "CatalystbyZoho_List_All_Columns",
      "CatalystbyZoho_Execute_Query",
      "CatalystbyZoho_Get_Table_Permissions",
      "CatalystbyZoho_Update_Table_Permissions",
      "CatalystbyZoho_Get_Table_Scopes",
      "CatalystbyZoho_Update_Table_Scopes",
      "CatalystbyZoho_Get_Authentication_Configurations",
      "CatalystbyZoho_List_All_Roles",
      "CatalystbyZoho_List_All_CORS_Domains",
      "CatalystbyZoho_List_All_Project_Users",
      "CatalystbyZoho_List_All_Functions",
      "CatalystbyZoho_List_All_Env_Variables",
      "CatalystbyZoho_List_All_Slate_Apps",
      "CatalystbyZoho_Get_Logs"
    ],
    "plan": []
  },
  "probes": [
    {
      "id": "P-LIKE",
      "measures": "LIKE '*x*' returns the row; '%x%' returns 0",
      "needed": true,
      "reason": "every migration verifies it"
    },
    {
      "id": "P-OFFSET",
      "measures": "LIMIT a,b offset base",
      "needed": true,
      "reason": "every migration verifies it"
    },
    {
      "id": "P-UPD300",
      "measures": "ZCQL UPDATE/DELETE statement cap",
      "needed": true,
      "reason": "every migration verifies it"
    },
    {
      "id": "P-JOIN",
      "measures": "max joins (Development and Production)",
      "needed": true,
      "reason": "every migration verifies it"
    },
    {
      "id": "P-WIDTH",
      "measures": "max select columns + exact error",
      "needed": true,
      "reason": "every migration verifies it"
    },
    {
      "id": "P-COLS",
      "measures": "columns per table by type (scratch table)",
      "needed": true,
      "reason": "every migration verifies it"
    },
    {
      "id": "P-401",
      "measures": "private route without auth returns 401",
      "needed": true,
      "reason": "every migration verifies it"
    },
    {
      "id": "P-BULK",
      "measures": "bulk write job path with a Stratus CSV",
      "needed": true,
      "reason": "run before the data load"
    },
    {
      "id": "P-RATE",
      "measures": "write rate before a large load",
      "needed": true,
      "reason": "run before the data load"
    },
    {
      "id": "P-SVC",
      "measures": "enabled services (console first-use on a fresh project)",
      "needed": false,
      "reason": "no Job Scheduling, Stratus or Signals use planned"
    },
    {
      "id": "P-MAIL",
      "measures": "send from the verified sender (customer confirms receipt)",
      "needed": false,
      "reason": "the app sends no mail"
    }
  ],
  "zcqlCaps": {
    "rowsPerQuery": 300,
    "offsetBase": 1,
    "likeWildcard": "*",
    "maxJoins": 4,
    "selectWidthDoc": 20,
    "selectWidthUnverified": 30
  }
}
