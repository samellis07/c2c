    {
      "id": "stratus-enable",
      "via": "console",
      "command": "Catalyst console → the project → Cloud Scale → Stratus → Start Exploring (<console>/baas/<org>/project/<project>/Development#/cloudscale), then on Create your First Bucket create one bucket (any name) — done when it shows in the bucket list (click Create again if nothing happens after a few seconds) — then c2c verifies it: c2c provision --record stratus-enable (GET /baas/v1/project/<project>/bucket)",
      "args": {
        "service": "Stratus"
      },
      "readBack": {
        "via": "cli",
        "command": "c2c provision --record stratus-enable",
        "args": {
          "call": {
            "method": "GET",
            "path": "/baas/v1/project/<project>/bucket"
          }
        },
        "match": {
          "gate": "open"
        }
      }
    },
    {
      "id": "bucket",
      "via": "mcp",
      "tool": "CatalystbyZoho_Create_Bucket",
      "args": {
        "path_variables": {
          "projectId": "<project>"
        },
        "headers": {
          "Catalyst-org": "<org>",
          "Environment": "Development"
        },
        "body": {
          "bucket_name": "c2c-kitchen-sink-studio-5d64898c",
          "bucket_meta": {
            "type": "protected"
          }
        }
      },
      "readBack": {
        "via": "mcp",
        "tool": "CatalystbyZoho_Get_All_Buckets",
        "match": {
          "bucket_name": "c2c-kitchen-sink-studio-5d64898c"
        }
      }
    },
    {
      "id": "auth-hosted",
      "via": "cli",
      "command": "c2c provision --confirm --run auth-hosted",
      "args": {
        "call": {
          "method": "POST",
          "path": "/baas/v1/project/<project>/authentication/enable?auth_type=hosted",
          "body": {
            "public_signup": false
          }
        }
      },
      "readBack": {
        "via": "mcp",
        "tool": "CatalystbyZoho_Get_Authentication_Configurations",
        "match": {
          "hosted_auth": true
        }
      }
    },
    {
      "id": "auth-embedded",
      "via": "cli",
      "command": "c2c provision --confirm --run auth-embedded",
      "args": {
        "call": {
          "method": "POST",
          "path": "/baas/v1/project/<project>/authentication/enable?auth_type=embedded",
          "body": {
            "public_signup": false
          }
        }
      },
      "readBack": {
        "via": "mcp",
        "tool": "CatalystbyZoho_Get_Authentication_Configurations",
        "match": {
          "embedded_auth": true
        }
      }
