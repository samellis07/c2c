            "method": "GET",
            "path": "/baas/v1/project/<project>/bucket"
          }
        },
        "match": {
          "gate": "open"
        }
      }
    },
    {
      "id": "bucket",
      "via": "mcp",
      "tool": "CatalystbyZoho_Create_Bucket",
      "args": {
        "path_variables": {
          "projectId": "<project>"
        },
        "headers": {
          "Catalyst-org": "<org>",
          "Environment": "Development"
        },
        "body": {
          "bucket_name": "c2c-kitchen-sink-studio-5d64898c",
          "bucket_meta": {
            "type": "protected"
          }
        }
      },
      "readBack": {
        "via": "mcp",
        "tool": "CatalystbyZoho_Get_All_Buckets",
        "match": {
          "bucket_name": "c2c-kitchen-sink-studio-5d64898c"
        }
      }
    },
    {
      "id": "auth-hosted",
      "via": "cli",
      "command": "c2c provision --confirm --run auth-hosted",
      "args": {
        "call": {
          "method": "POST",
          "path": "/baas/v1/project/<project>/authentication/enable?auth_type=hosted",
          "body": {
            "public_signup": false
          }
        }
      },
      "readBack": {
        "via": "mcp",
        "tool": "CatalystbyZoho_Get_Authentication_Configurations",
        "match": {
          "hosted_auth": true
        }
      }
    },
    {
      "id": "auth-embedded",
      "via": "cli",
      "command": "c2c provision --confirm --run auth-embedded",
      "args": {
        "call": {
          "method": "POST",
          "path": "/baas/v1/project/<project>/authentication/enable?auth_type=embedded",
          "body": {
            "public_signup": false
          }
        }
      },
      "readBack": {
        "via": "mcp",
        "tool": "CatalystbyZoho_Get_Authentication_Configurations",
        "match": {
          "embedded_auth": true
        }
      }
    },
    {
      "id": "import-roles",
      "via": "mcp",
      "tool": "CatalystbyZoho_List_All_Roles",
      "args": {
        "path_variables": {
          "projectId": "<project>"
        },
        "headers": {
          "Catalyst-org": "<org>",
          "Environment": "Development"
        },
        "note": "the IaC import created these roles; this step only proves them — a mismatch means the import did not apply them"
      },
      "readBack": {
        "via": "mcp",
        "tool": "CatalystbyZoho_List_All_Roles",
        "match": {
          "role_name": [
            "Administrator",
            "Desk_Staff",
            "Studio_Lead",
            "Studio_Crew"
          ]
        }
      }
    },
    {
      "id": "slate-enable",
      "via": "console",
      "command": "Catalyst console → the project → Slate → Start Exploring (<console>/baas/<org>/project/<project>/Development#/slate) — then c2c verifies it: c2c provision --record slate-enable (GET /slate/v1/project/<project>/app)",
      "args": {
        "service": "Slate"
      },
      "readBack": {
        "via": "cli",
        "command": "c2c provision --record slate-enable",
        "args": {
          "call": {
            "method": "GET",
            "path": "/slate/v1/project/<project>/app"
          }
        },
        "match": {
          "gate": "open"
        }
      }
    },
    {
      "id": "authorized-domain",
      "via": "cli",
      "command": "c2c provision --confirm --run authorized-domain (after the Slate deploy, when the App URL host is known)",
      "args": {
        "call": {
          "method": "POST",
          "path": "/baas/v1/project/<project>/cors-domain",
          "body": {
            "domain": "<slate-app-url-host>",
            "cors": true,
            "iframe": true
          }
        }
      },
      "readBack": {
        "via": "mcp",
        "tool": "CatalystbyZoho_List_All_CORS_Domains",
        "match": {
          "<slate-app-url-host>": {
            "cors": true,
            "iframe": true
          }
        }
      }
    },
    {
      "id": "sign-in-check",
      "via": "console",
      "command": "Open the Slate app URL — the sign-in box must show the Catalyst sign-in page, not the app itself or a blank box. A blank box means iFrame is off for the host: Authentication > Whitelisting > the Slate host > Edit > iFrame on, then reload.",
      "args": {},
      "readBack": {
        "via": "console",
        "command": "record the check: c2c provision --record sign-in-check --result <file> ({\"sign_in_page\": true} once the sign-in page shows)",
        "match": {
          "sign_in_page": true
        }
      }
    },
    {
      "id": "import-security-rule",
      "via": "mcp",
      "tool": "CatalystbyZoho_List_All_Functions",
      "args": {
        "path_variables": {
          "projectId": "<project>"
        },
        "headers": {
          "Catalyst-org": "<org>",
          "Environment": "Development"
        },
        "note": "the IaC SecurityRules item requires authentication for c2c_api; List_All_Functions exposes is_authenticated — this step only proves the import applied it"
      },
      "readBack": {
        "via": "mcp",
        "tool": "CatalystbyZoho_List_All_Functions",
        "match": {
          "c2c_api": {
            "is_authenticated": true
          }
        }
      }
    },
    {
      "id": "crons",
      "via": "cli",
      "command": "c2c provision --confirm --run crons (crons are created disabled; the user enables each in the console)",
      "args": {
        "plan": "provision/crons.json",
        "schedules": 1,
        "enabled": false
      },
      "readBack": {
        "via": "mcp",
        "tool": "CatalystbyZoho_List_All_Crons",
        "match": {
          "cron_name": [
            "daily_sweep"
          ]
        }
      }
    }
  ],
  "mcpTools": {
    "base": [
      "CatalystbyZoho_List_All_Organizations",
      "CatalystbyZoho_List_All_Tables",
